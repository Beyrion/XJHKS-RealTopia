diff --git a/src/server/__tests__/frameReader.session.test.ts b/src/server/__tests__/frameReader.session.test.ts
new file mode 100644
index 0000000..81f93f9
--- /dev/null
+++ b/src/server/__tests__/frameReader.session.test.ts
@@ -0,0 +1,34 @@
+import { EventEmitter } from 'node:events';
+import type net from 'node:net';
+import { describe, expect, it, vi } from 'vitest';
+import { FrameReader } from '../FrameReader';
+
+describe('FrameReader scrcpy v4 session packets', () => {
+    it('emits rotated dimensions and continues parsing media frames', () => {
+        const socket = new EventEmitter() as net.Socket;
+        const reader = new FrameReader(socket);
+        const onSession = vi.fn();
+        const onFrame = vi.fn();
+        reader.onSession(onSession);
+        reader.onFrame(onFrame);
+
+        const session = Buffer.alloc(12);
+        session.writeUInt32BE(0x80000000, 0);
+        session.writeUInt32BE(1920, 4);
+        session.writeUInt32BE(1080, 8);
+
+        const payload = Buffer.from([1, 2, 3]);
+        const media = Buffer.alloc(12 + payload.length);
+        media.writeBigUInt64BE(123n, 0);
+        media.writeUInt32BE(payload.length, 8);
+        payload.copy(media, 12);
+
+        socket.emit('data', Buffer.concat([session, media]));
+
+        expect(onSession).toHaveBeenCalledOnce();
+        expect(onSession).toHaveBeenCalledWith({ width: 1920, height: 1080, clientResized: false });
+        expect(onFrame).toHaveBeenCalledOnce();
+        expect(onFrame.mock.calls[0]?.[0]).toMatchObject({ type: 'frame', pts: 123n });
+        expect(onFrame.mock.calls[0]?.[0].data).toEqual(payload);
+    });
+});
