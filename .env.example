# Either point at the reference checkout containing .jdk/.android-sdk,
# or omit this and set JAVA_HOME, ANDROID_HOME and NDK_HOME separately.
ANDROID_REFERENCE_DIR=/absolute/path/to/indoor-vln-app-demo

# Required by deploy.sh; PHONE_SERIAL is also required by test-face-android.sh.
GLASS_SERIAL=your-glasses-adb-serial
PHONE_SERIAL=your-phone-adb-serial

# Optional override when adb is not under ANDROID_HOME/platform-tools.
# ADB=/absolute/path/to/adb

# Optional host-side Alibaba Cloud Model Studio smoke test. Never commit a real
# key; Android credentials are entered in Settings > Intelligence and encrypted
# with AndroidKeyStore instead of being embedded at build time.
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://llm-91vwfbm1df53hn0g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
