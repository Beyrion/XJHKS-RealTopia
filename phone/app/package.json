    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.54.2",
    "prettier": "^3.9.6",
