{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealTopia",
  "version": "0.1.0",
  "identifier": "com.realtopia.phone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RealTopia Link",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/stranger-faces/**",
          "$APPDATA/person-photos/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 28 },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
